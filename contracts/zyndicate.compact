pragma language_version 0.23;

import CompactStandardLibrary;

// ============================================================================
// ZYNDICATE — confidential work-coordination protocol (Midnight MVP)
//
// One primary contract with clearly separated internal sections:
//   Identity | Mandate | Bid | Award | Submission | Evaluation |
//   Vault/Settlement | Reputation | Dispute
//
// Privacy rule (PRD 13): the public ledger holds ONLY commitments, state
// enums, deadlines, nullifier sets, counters, and hashed role keys.
// No budgets, no bid values, no identities.
//
// Disclosure convention: exported-circuit parameters are private inputs to
// the proof until disclosed. Every parameter that is *meant* to be public
// (commitments, nullifiers, deadlines, ids — all computed client-side for
// publication) is bound to a disclosed local at the top of its circuit.
// Witness values are NEVER disclosed raw — only domain-separated hashes.
// ============================================================================

// ----------------------------------------------------------------------------
// Mandate state machine (Class A: public)
// ----------------------------------------------------------------------------

export enum MandateState {
  OPEN_FOR_BIDS,
  BIDDING_CLOSED,
  AWARDED,
  IN_EXECUTION,
  SUBMITTED,
  ACCEPTED,
  SETTLED,
  DISPUTED,
  RESOLVED,
  CANCELLED
}

export enum Verdict { PENDING, ACCEPT, REJECT, REVISE }

// ----------------------------------------------------------------------------
// Ledger state — every field is Class A (public): commitments, hashes,
// enums, deadlines, nullifiers, counters. Nothing confidential lands here.
// ----------------------------------------------------------------------------

// Identity: deploy-time role authorities (hashed role keys, sealed at deploy)
export sealed ledger evaluatorAuthority: Bytes<32>;
export sealed ledger tribunalAuthority: Bytes<32>;
export sealed ledger issuerAuthority: Bytes<32>;

// Identity: registry of issued operator credential hashes (Merkle membership)
export ledger credentialRegistry: HistoricMerkleTree<10, Bytes<32>>;
export ledger credentialCount: Counter;

// Mandate
export ledger mandateCount: Counter;
export ledger mandateStates: Map<Field, MandateState>;
export ledger mandateCommitments: Map<Field, Bytes<32>>;
export ledger covenantCommitments: Map<Field, Bytes<32>>;
export ledger mandateDomains: Map<Field, Bytes<32>>;
export ledger principalKeys: Map<Field, Bytes<32>>;
export ledger bidDeadlines: Map<Field, Uint<64>>;
export ledger executionDeadlines: Map<Field, Uint<64>>;

// Bid
export ledger bidRegistry: Map<Bytes<32>, Field>;  // bid commitment -> mandate id
export ledger bidCounts: Map<Field, Uint<16>>;
export ledger bidNullifiers: Set<Bytes<32>>;

// Award
export ledger winningBids: Map<Field, Bytes<32>>;
export ledger operatorKeys: Map<Field, Bytes<32>>;

// Submission
export ledger artifactCommitments: Map<Field, Bytes<32>>;
export ledger receiptCommitments: Map<Field, Bytes<32>>;

// Evaluation
export ledger evaluationCommitments: Map<Field, Bytes<32>>;
export ledger verdicts: Map<Field, Verdict>;

// Vault / settlement
export ledger settlementNullifiers: Set<Bytes<32>>;

// Reputation / receipts
export ledger receiptNullifiers: Set<Bytes<32>>;
export ledger settledMandates: Counter;
export ledger issuedReceipts: Counter;

// Dispute
export ledger disputeCommitments: Map<Field, Bytes<32>>;
export ledger rulingCommitments: Map<Field, Bytes<32>>;

constructor(
  initialEvaluatorAuthority: Bytes<32>,
  initialTribunalAuthority: Bytes<32>,
  initialIssuerAuthority: Bytes<32>
) {
  // Deploy-time configuration: hashed role keys, public by design.
  evaluatorAuthority = disclose(initialEvaluatorAuthority);
  tribunalAuthority = disclose(initialTribunalAuthority);
  issuerAuthority = disclose(initialIssuerAuthority);
}

// ----------------------------------------------------------------------------
// Witnesses — private local data (Class D). NEVER trusted without an
// in-circuit assert; every use below is constrained against ledger state.
// ----------------------------------------------------------------------------

witness principalSecretKey(): Bytes<32>;
witness operatorSecretKey(): Bytes<32>;
witness operatorCredentialSecret(): Bytes<32>;
witness credentialPath(): MerkleTreePath<10, Bytes<32>>;
witness evaluatorSecretKey(): Bytes<32>;
witness tribunalSecretKey(): Bytes<32>;
witness issuerSecretKey(): Bytes<32>;
witness bidOpeningPrice(): Uint<64>;
witness bidOpeningRand(): Bytes<32>;

// ----------------------------------------------------------------------------
// Derivation circuits — domain-separated key / commitment / nullifier
// derivation via persistentHash + pad(32, "zyndicate:...").
// A unique separator per purpose keeps every hash namespace disjoint.
// ----------------------------------------------------------------------------

export pure circuit derivePrincipalKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zyndicate:principal:"), sk]);
}

export pure circuit deriveOperatorKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zyndicate:operator:"), sk]);
}

export pure circuit deriveEvaluatorKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zyndicate:evaluator:"), sk]);
}

export pure circuit deriveTribunalKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zyndicate:tribunal:"), sk]);
}

export pure circuit deriveIssuerKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zyndicate:issuer:"), sk]);
}

export pure circuit deriveCredentialHash(credentialSecret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zyndicate:cred:"), credentialSecret]);
}

export pure circuit deriveBidNullifier(mandateId: Field, credentialSecret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "zyndicate:bid:nul:"), mandateId as Bytes<32>, credentialSecret]);
}

export pure circuit deriveSettlementNullifier(mandateId: Field, principalSk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "zyndicate:settle:nul:"), mandateId as Bytes<32>, principalSk]);
}

export pure circuit deriveReceiptNullifier(mandateId: Field, operatorSk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "zyndicate:receipt:nul:"), mandateId as Bytes<32>, operatorSk]);
}

export pure circuit deriveBidCommitment(
  mandateId: Field,
  price: Uint<64>,
  operatorSk: Bytes<32>,
  rand: Bytes<32>
): Bytes<32> {
  return persistentCommit<Vector<3, Bytes<32>>>(
    [mandateId as Bytes<32>, price as Field as Bytes<32>, deriveOperatorKey(operatorSk)],
    rand);
}

// ----------------------------------------------------------------------------
// Internal guards (inlined helpers, not entry points).
// All take an already-disclosed mandate id.
// ----------------------------------------------------------------------------

circuit requireMandate(mandateId: Field): [] {
  assert(mandateStates.member(mandateId), "unknown mandate");
}

circuit requirePrincipal(mandateId: Field): [] {
  assert(principalKeys.lookup(mandateId) == derivePrincipalKey(principalSecretKey()),
    "caller is not the mandate principal");
}

circuit requireOperator(mandateId: Field): [] {
  assert(operatorKeys.member(mandateId), "no operator recorded for mandate");
  assert(operatorKeys.lookup(mandateId) == deriveOperatorKey(operatorSecretKey()),
    "caller is not the awarded operator");
}

// ----------------------------------------------------------------------------
// Identity module — credential issuance (issuer-authorized)
// ----------------------------------------------------------------------------

export circuit registerCredential(credentialHash: Bytes<32>): [] {
  const credHash = disclose(credentialHash);
  assert(issuerAuthority == deriveIssuerKey(issuerSecretKey()),
    "caller is not the credential issuer");
  assert(!credentialRegistry.isFull(), "credential registry is full");
  credentialRegistry.insert(credHash);
  credentialCount.increment(1);
}

// ----------------------------------------------------------------------------
// Mandate module — creation and bid-window lifecycle
// ----------------------------------------------------------------------------

export circuit createMandate(
  mandateCommitment: Bytes<32>,
  covenantCommitment: Bytes<32>,
  publicDomain: Bytes<32>,
  bidDeadline: Uint<64>,
  executionDeadline: Uint<64>
): Field {
  const mCommit = disclose(mandateCommitment);
  const cCommit = disclose(covenantCommitment);
  const domain = disclose(publicDomain);
  const bidDl = disclose(bidDeadline);
  const execDl = disclose(executionDeadline);
  assert(blockTimeLt(bidDl), "bid deadline must be in the future");
  assert(bidDl <= execDl, "execution deadline precedes bid deadline");
  mandateCount.increment(1);
  const mandateId = mandateCount.read() as Field;
  mandateStates.insert(mandateId, MandateState.OPEN_FOR_BIDS);
  mandateCommitments.insert(mandateId, mCommit);
  covenantCommitments.insert(mandateId, cCommit);
  mandateDomains.insert(mandateId, domain);
  // Deliberate disclosure: a preimage-resistant, domain-separated hash of the
  // principal's high-entropy secret key. Reveals no identity information.
  principalKeys.insert(mandateId, disclose(derivePrincipalKey(principalSecretKey())));
  bidDeadlines.insert(mandateId, bidDl);
  executionDeadlines.insert(mandateId, execDl);
  bidCounts.insert(mandateId, 0);
  return mandateId;
}

export circuit closeBidWindow(mandateId: Field): [] {
  const id = disclose(mandateId);
  requireMandate(id);
  assert(mandateStates.lookup(id) == MandateState.OPEN_FOR_BIDS,
    "bid window is not open");
  requirePrincipal(id);
  mandateStates.insert(id, MandateState.BIDDING_CLOSED);
}

export circuit cancelMandate(mandateId: Field): [] {
  const id = disclose(mandateId);
  requireMandate(id);
  const s = mandateStates.lookup(id);
  assert(s == MandateState.OPEN_FOR_BIDS || s == MandateState.BIDDING_CLOSED,
    "mandate can no longer be cancelled");
  requirePrincipal(id);
  mandateStates.insert(id, MandateState.CANCELLED);
}

// ----------------------------------------------------------------------------
// Bid module — sealed bids with in-circuit eligibility and duplicate
// prevention via credential-bound nullifiers
// ----------------------------------------------------------------------------

export circuit submitBid(
  mandateId: Field,
  bidCommitment: Bytes<32>,
  bidNullifier: Bytes<32>
): [] {
  const id = disclose(mandateId);
  const commitment = disclose(bidCommitment);
  const nullifier = disclose(bidNullifier);
  requireMandate(id);
  assert(mandateStates.lookup(id) == MandateState.OPEN_FOR_BIDS,
    "bid window is not open");
  assert(blockTimeLt(bidDeadlines.lookup(id)), "bid deadline has passed");

  // Eligibility: prove membership of an issued credential in the registry
  // without revealing WHICH credential (Merkle path stays in the proof).
  const credential = operatorCredentialSecret();
  const path = credentialPath();
  assert(path.leaf == deriveCredentialHash(credential),
    "credential path does not open the presented credential");
  assert(credentialRegistry.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
    "operator credential is not registered");

  // The nullifier must be honestly derived from the consumed credential and
  // this mandate; the same credential can bid at most once per mandate.
  assert(nullifier == deriveBidNullifier(id, credential),
    "malformed bid nullifier");
  assert(!bidNullifiers.member(nullifier), "duplicate bid");
  bidNullifiers.insert(nullifier);

  assert(!bidRegistry.member(commitment), "bid commitment already registered");
  bidRegistry.insert(commitment, id);
  bidCounts.insert(id, (bidCounts.lookup(id) + 1) as Uint<16>);
}

// ----------------------------------------------------------------------------
// Award module — principal selects a winner; operator proves knowledge of
// the winning bid opening to accept
// ----------------------------------------------------------------------------

export circuit awardBid(mandateId: Field, winningBidCommitment: Bytes<32>): [] {
  const id = disclose(mandateId);
  const winner = disclose(winningBidCommitment);
  requireMandate(id);
  assert(mandateStates.lookup(id) == MandateState.BIDDING_CLOSED,
    "bidding is not closed");
  requirePrincipal(id);
  assert(bidRegistry.member(winner), "winning bid was never registered");
  assert(bidRegistry.lookup(winner) == id, "bid belongs to a different mandate");
  winningBids.insert(id, winner);
  mandateStates.insert(id, MandateState.AWARDED);
}

export circuit acceptAward(mandateId: Field): [] {
  const id = disclose(mandateId);
  requireMandate(id);
  assert(mandateStates.lookup(id) == MandateState.AWARDED,
    "mandate is not awarded");
  // The operator proves knowledge of the winning bid opening (price,
  // operator key, randomness) without revealing any of it.
  const sk = operatorSecretKey();
  const reconstructed = deriveBidCommitment(id, bidOpeningPrice(), sk, bidOpeningRand());
  assert(winningBids.lookup(id) == reconstructed,
    "caller cannot open the winning bid");
  // Deliberate disclosure: domain-separated hash of the operator's secret
  // key, used from here on as the operator's on-chain role key.
  operatorKeys.insert(id, disclose(deriveOperatorKey(sk)));
  mandateStates.insert(id, MandateState.IN_EXECUTION);
}

// ----------------------------------------------------------------------------
// Submission module — deadline-checked artifact + execution receipt commit
// ----------------------------------------------------------------------------

export circuit commitSubmission(
  mandateId: Field,
  artifactCommitment: Bytes<32>,
  receiptCommitment: Bytes<32>
): [] {
  const id = disclose(mandateId);
  const artifact = disclose(artifactCommitment);
  const receipt = disclose(receiptCommitment);
  requireMandate(id);
  assert(mandateStates.lookup(id) == MandateState.IN_EXECUTION,
    "mandate is not in execution");
  requireOperator(id);
  assert(blockTimeLt(executionDeadlines.lookup(id)),
    "execution deadline has passed");
  artifactCommitments.insert(id, artifact);
  receiptCommitments.insert(id, receipt);
  mandateStates.insert(id, MandateState.SUBMITTED);
}

// ----------------------------------------------------------------------------
// Evaluation module — evaluator-authorized verdict on a submission
// ----------------------------------------------------------------------------

export circuit recordEvaluation(
  mandateId: Field,
  evaluationCommitment: Bytes<32>,
  verdict: Verdict
): [] {
  const id = disclose(mandateId);
  const evaluation = disclose(evaluationCommitment);
  const v = disclose(verdict);
  requireMandate(id);
  assert(mandateStates.lookup(id) == MandateState.SUBMITTED,
    "mandate has no pending submission");
  assert(evaluatorAuthority == deriveEvaluatorKey(evaluatorSecretKey()),
    "caller is not the authorized evaluator");
  assert(v != Verdict.PENDING, "verdict must be decisive");
  evaluationCommitments.insert(id, evaluation);
  verdicts.insert(id, v);
  if (v == Verdict.ACCEPT) {
    mandateStates.insert(id, MandateState.ACCEPTED);
  } else {
    // REJECT / REVISE return the mandate to execution for a revised
    // submission before the execution deadline.
    mandateStates.insert(id, MandateState.IN_EXECUTION);
  }
}

// ----------------------------------------------------------------------------
// Vault / settlement module — single settlement enforced by nullifier set;
// a DISPUTED state freezes settlement until the tribunal resolves it
// ----------------------------------------------------------------------------

export circuit settleMandate(mandateId: Field, settlementNullifier: Bytes<32>): [] {
  const id = disclose(mandateId);
  const nullifier = disclose(settlementNullifier);
  requireMandate(id);
  const s = mandateStates.lookup(id);
  assert(s == MandateState.ACCEPTED || s == MandateState.RESOLVED,
    "mandate is not ready to settle");
  requirePrincipal(id);
  assert(nullifier == deriveSettlementNullifier(id, principalSecretKey()),
    "malformed settlement nullifier");
  assert(!settlementNullifiers.member(nullifier), "mandate already settled");
  settlementNullifiers.insert(nullifier);
  settledMandates.increment(1);
  mandateStates.insert(id, MandateState.SETTLED);
}

// ----------------------------------------------------------------------------
// Dispute module — either party may freeze settlement; only the tribunal
// authority may resolve
// ----------------------------------------------------------------------------

export circuit openDispute(mandateId: Field, disputeCommitment: Bytes<32>): [] {
  const id = disclose(mandateId);
  const dispute = disclose(disputeCommitment);
  requireMandate(id);
  const s = mandateStates.lookup(id);
  assert(s == MandateState.SUBMITTED || s == MandateState.ACCEPTED,
    "mandate is not in a disputable state");
  // Either party to the mandate may open a dispute. In both permitted
  // states an operator key is guaranteed to be recorded.
  const isPrincipal =
    principalKeys.lookup(id) == derivePrincipalKey(principalSecretKey());
  const isOperator =
    operatorKeys.lookup(id) == deriveOperatorKey(operatorSecretKey());
  assert(isPrincipal || isOperator, "caller is not a party to the mandate");
  disputeCommitments.insert(id, dispute);
  mandateStates.insert(id, MandateState.DISPUTED);
}

export circuit resolveDispute(mandateId: Field, rulingCommitment: Bytes<32>): [] {
  const id = disclose(mandateId);
  const ruling = disclose(rulingCommitment);
  requireMandate(id);
  assert(mandateStates.lookup(id) == MandateState.DISPUTED,
    "mandate is not disputed");
  assert(tribunalAuthority == deriveTribunalKey(tribunalSecretKey()),
    "caller is not the tribunal authority");
  rulingCommitments.insert(id, ruling);
  mandateStates.insert(id, MandateState.RESOLVED);
}

// ----------------------------------------------------------------------------
// Reputation module — duplicate-proof completion receipts
// ----------------------------------------------------------------------------

export circuit issueReceipt(mandateId: Field, receiptNullifier: Bytes<32>): [] {
  const id = disclose(mandateId);
  const nullifier = disclose(receiptNullifier);
  requireMandate(id);
  assert(mandateStates.lookup(id) == MandateState.SETTLED,
    "mandate is not settled");
  requireOperator(id);
  assert(nullifier == deriveReceiptNullifier(id, operatorSecretKey()),
    "malformed receipt nullifier");
  assert(!receiptNullifiers.member(nullifier), "receipt already issued");
  receiptNullifiers.insert(nullifier);
  issuedReceipts.increment(1);
}
